{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "eve/workflow-modules"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts",
    "agent/**/*.ts",
    "worker/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}